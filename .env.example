# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Chemins (dans le conteneur Docker)
RESULTS_DIR=/app/data/results
SELENIUM_PROFILE_DIR=/app/data/selenium_profiles/amazon

# Selenium
DEFAULT_WAIT_SECONDS=15

# Modèles IA (Hugging Face)
SENTIMENT_MODEL=nlptown/bert-base-multilingual-uncased-sentiment
RESPONSE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# CORS
CORS_ORIGINS=["*"]
